# Base de datos
#  - Desarrollo local sin instalar nada: SQLite en un archivo
DATABASE_URL=file:./plantilla.db
#  - Producción / staging: PostgreSQL (se detecta solo por el prefijo postgres://)
# DATABASE_URL=postgres://usuario:clave@localhost:5432/edificio

# Clave para firmar sesiones de Payload (generá una larga y aleatoria por proyecto)
PAYLOAD_SECRET=cambiame-por-una-clave-larga

# URL pública del sitio (metadatos, links absolutos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Usuario administrador que crea el seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=cambiar123

# Google Maps Embed API (opcional): sólo para las "Búsquedas de cercanías" de Ubicación. El mapa y Street View
# no la necesitan. Es pública (va en el iframe): restringila por dominio y a la Maps Embed API en Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
# Email (Resend): avisos de consultas y "restablecer contraseña" del admin. Sin API key los mails se imprimen en la
# consola del server. El remitente tiene que ser de un dominio verificado en Resend (ej. consultas@midominio.com).
RESEND_API_KEY=
EMAIL_REMITENTE=
EMAIL_REMITENTE_NOMBRE=
